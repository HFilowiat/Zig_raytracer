# Demo cube used by scenes/demo.zon.
# Two materials exercise the MTL mapping: a fuzzy metal shell and a diffuse trim.

mtllib cube.mtl
o cube

v -1 -1 -1
v  1 -1 -1
v  1  1 -1
v -1  1 -1
v -1 -1  1
v  1 -1  1
v  1  1  1
v -1  1  1

g front
usemtl shell
f 1 2 3 4
f 5 8 7 6

g bottom
f 1 5 6 2
f 4 3 7 8

g left
usemtl trim
f 1 4 8 5
f 2 6 7 3
