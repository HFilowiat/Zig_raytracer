    .camera = .{
        .lookfrom = .{ 0.0, 0.795, 2.92 },
        .lookat = .{ 0.0, 0.795, 0.0 },
        .vup = .{ 0.0, 1.0, 0.0 },
        .vfov = 40.0,
    },
    .background = .{ 0.0, 0.0, 0.0 },
    .objects = .{
        .{ .mesh = .{ .path = "Cornell_boxes/CornellBox-Water.obj" } },
    },
}
